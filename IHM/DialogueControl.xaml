<UserControl x:Class="IHM.DialogueControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <!-- Panneau global qui capture les clics -->
    <Grid Background="Transparent" MouseDown="OnClickNext">
        <Grid VerticalAlignment="Bottom">
            <Image Source="Resources/IMG_background/dialog.png"
                   Stretch="None"
                   Opacity="0.9"/>

            <!-- Texte positionné à l'intérieur de l'image -->
            <TextBlock x:Name="DialogueText"
                       Foreground="White"
                       FontSize="20"
                       FontFamily="Segoe Script"
                       TextWrapping="Wrap"
                       Margin="40,575,40,20" 
                       Width="1000"
                       VerticalAlignment="Top"/>
        </Grid>    
    </Grid>
</UserControl>