## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Rider / IntelliJ
.idea/

# Visual Studio
.vs/

# NuGet
*.nupkg
*.snupkg
*.nuspec
*.psmdcp
.nuget/

# Microsoft Azure Web App publish settings
PublishProfiles/

# Windows image file caches
Thumbs.db
ehthumbs.db

# Autogenerated files
Generated\ Files/

# Backup & report files from crashes
*.stackdump
*.bak
*.Backup
*.Bkp
*.tmp
*.temp

# Others
*.log
